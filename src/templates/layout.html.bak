<!DOCTYPE html>
<html lang="en" class="bebas_neue_cf1ac3f8-module__vf5yua__variable playfair_display_799fd6d5-module__e0DIoq__variable inter_ac783c7d-module__CnGMva__variable">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    
    <!-- SEO and Metadata -->
    <title>{{title}}</title>
    <meta name="description" content="{{description}}"/>
    <meta name="author" content="Kush Agrawal"/>
    <meta name="keywords" content="Kush Agrawal,Software Engineer,Portfolio,Web Development,AI Automation,React,Next.js,Data Analytics,Cybersecurity"/>
    <meta name="robots" content="index, follow"/>
    <link rel="canonical" href="{{canonical}}"/>
    
    <meta property="og:title" content="{{title}}"/>
    <meta property="og:description" content="{{description}}"/>
    <meta property="og:url" content="{{canonical}}"/>
    <meta property="og:site_name" content="Kush Agrawal's Portfolio"/>
    <meta property="og:locale" content="en_US"/>
    <meta property="og:type" content="website"/>
    
    <link rel="icon" href="/icon.png" type="image/png"/>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    
    <!-- Style Sheets -->
    <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>
    
    <!-- Header Component -->
    {{header}}

    <!-- Main Content -->
    {{content}}

    <!-- Javascript Interactions -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>

